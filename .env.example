# --- Base de datos ---
POSTGRES_USER=calidad
POSTGRES_PASSWORD=calidad
POSTGRES_DB=calidad_ford
POSTGRES_PORT=5432

# URL usada por Prisma (fuera de Docker apuntar a localhost)
DATABASE_URL=postgresql://calidad:calidad@localhost:5432/calidad_ford?schema=public

# --- Redis / BullMQ ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Backend ---
PORT=3000
NODE_ENV=development

# --- Nginx ---
HTTP_PORT=80

# --- Meta WhatsApp Cloud API ---
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Nombre del template aprobado en Meta (variables: nombre, modelo, fecha de salida)
META_TEMPLATE_NAME=contacto_posventa
META_TEMPLATE_LANG=es_AR
# Plantilla del recordatorio de Fidelización (Parte C), pendiente de aprobación en Meta
META_FIDELIZACION_TEMPLATE_NAME=fidelizacion_posventa
# Base de la Graph API (solo cambiar para apuntar a un mock en pruebas)
META_GRAPH_BASE_URL=https://graph.facebook.com/v20.0
# Delay entre mensajes de campaña para no chocar con rate limits de Meta
WHATSAPP_ENVIO_DELAY_MS=2500
# Días sin respuesta tras el envío para marcar NO_RESPONDIO (cron diario)
DIAS_SIN_RESPUESTA_PARA_NC=5
# Ventana horaria y tope diario de envíos de campaña (hora Argentina): protege a
# los clientes (nada de madrugada) y a la cuenta de Meta. Los mensajes fuera de
# horario o por encima del tope esperan en cola y salen cuando abre la ventana.
MAX_ENVIOS_DIARIOS=200
HORA_INICIO_ENVIO=09:00
HORA_FIN_ENVIO=19:00

# --- IA (análisis de sentimiento / causa raíz) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Proveedor alternativo (opcional): si hay key de Gemini y NO de Anthropic, el
# análisis usa Gemini de verdad (vía REST, sin dependencia extra).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Fuerza el proveedor de IA: "gemini" | "anthropic". Vacío = automático (usa la
# key que esté cargada). Solo aplica si hay una API key real de ese proveedor.
AI_PROVIDER=
# true = respuestas simuladas por palabras clave, sin llamar a la API (para probar el flujo sin gastar)
ANALISIS_MODO_MOCK=false
# Tope de análisis por minuto (rate limiter de la cola).
#  - FREE TIER de Gemini (bajo RPM): dejar en 8 para no disparar errores 429.
#  - TIER PAGO (billing habilitado): se puede subir bastante (ej. 30) para
#    clasificar campañas grandes más rápido. Si volvés al free tier, poné 8 de nuevo.
ANALISIS_MAX_POR_MINUTO=8

# --- Modo demostración ---
# true = muestra el sistema de punta a punta SIN credenciales reales: simula el
# envío de WhatsApp (marca el caso ENVIADO igual que en producción) y habilita
# "Simular respuesta del cliente" en /casos. Si NO hay ninguna key de IA real
# (Anthropic ni Gemini), también simula el análisis; si hay key, la usa de verdad.
# En false, el sistema se comporta exactamente igual que hoy.
MODO_DEMO=false
# Demora del mensaje de agradecimiento tras el ÚLTIMO mensaje del cliente
# (deliberada, para que no parezca un robot). Producción: 180000 (3 min).
DELAY_AGRADECIMIENTO_MS=180000

# Ventana de consolidación de la respuesta del cliente (ms). Cada mensaje nuevo
# reinicia la cuenta: el análisis corre cuando el cliente estuvo este tiempo sin
# escribir, y analiza TODA la tanda de una sola vez (una sola llamada a la IA,
# una sola clasificación). Bajarlo hace la demo más ágil; subirlo tolera mejor
# a los clientes que escriben lento.
DELAY_ANALISIS_MS=90000

# --- Cifrado de secretos guardados en Configuración (credenciales de Meta) ---
# 32 bytes en hex (openssl rand -hex 32) o base64. Necesaria para cargar el token
# de WhatsApp desde /configuracion. OJO: si la rotás, los secretos ya guardados
# quedan ilegibles y hay que volver a cargarlos.
CONFIG_ENCRYPTION_KEY=

# --- Autenticación ---
# Generar con: openssl rand -hex 32 (nunca reutilizar el mismo valor entre entornos)
JWT_SECRET=
JWT_EXPIRES_IN=8h
# CORS: en desarrollo dejar vacío (se refleja el origen). En producción, el/los
# dominio(s) reales del frontend, separados por coma (nunca "*").
FRONTEND_URL=
# Tope de requests por minuto por IP para toda la API (anti abuso / loops)
RATE_LIMIT_POR_MINUTO=100
# Usuario ADMIN que crea el seed la primera vez que arranca el backend.
# Solo se usa si ese email todavía no existe en la base (no pisa contraseñas ya cambiadas).
ADMIN_EMAIL=
ADMIN_PASSWORD_INICIAL=

# --- Solo DESARROLLO: hosts permitidos por el dev server de Vite ---
# Evita el error "Blocked request. This host is not allowed" al exponer el
# frontend de desarrollo por ngrok u otro dominio. Separar por coma; un host con
# punto inicial (".ngrok-free.app") habilita todos sus subdominios.
# NO aplica al stack de producción: ahí el frontend lo sirve nginx ya compilado
# y este chequeo no existe.
VITE_ALLOWED_HOSTS=

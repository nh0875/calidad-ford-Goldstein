# ============================================================================
# .env del SERVIDOR (Podman/Portainer) — Sistema de Calidad Ford
# ============================================================================
# Copiar a  .env.prod  en el servidor y completar. Se usa con el compose del
# repo (docker-compose.prod.yml).  MUCHOS valores son SECRETOS: no commitear.
#
# ⚠️ MIGRACIÓN: los valores marcados con [COPIAR DE VANINA] tienen que ser
#    EXACTAMENTE los mismos que hoy están en el .env.prod de la PC de Vanina, o
#    la base migrada no se puede leer (el token de Meta está cifrado con la
#    CONFIG_ENCRYPTION_KEY; si cambia, se pierde y hay que recargarlo a mano).
# ============================================================================

# Guarda anti-confusión de entorno (tiene que existir; el backend falla si no).
ENTORNO_PROD=1

# ---- Base de datos ----
POSTGRES_USER=calidad
POSTGRES_PASSWORD=            # [COPIAR DE VANINA] (o uno nuevo si se restaura con ese)
POSTGRES_DB=calidad_ford

# ---- Secretos de la app ----
# La clave que cifra las credenciales de Meta guardadas en la base.
CONFIG_ENCRYPTION_KEY=        # [COPIAR DE VANINA]  ⚠️ imprescindible para no perder el token de Meta
JWT_SECRET=                   # puede ser nuevo (solo obliga a re-loguearse una vez)
JWT_EXPIRES_IN=8h

# Admin inicial (solo se usa si la base arranca vacía; al migrar, ya existe)
ADMIN_EMAIL=
ADMIN_PASSWORD_INICIAL=

# ---- IA (van por env, NO están en la base: hay que setearlas sí o sí) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=              # [COPIAR DE VANINA]
GEMINI_MODEL=gemini-2.5-flash
ANALISIS_MAX_POR_MINUTO=8

# ---- Meta / WhatsApp ----
# Si se MIGRA la base con la misma CONFIG_ENCRYPTION_KEY, estas pueden quedar
# vacías (el sistema las lee cifradas de la base). Si se arranca de cero, cargarlas
# acá o desde la pantalla de Configuración.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Plantillas (una por área). El idioma tiene que ser el aprobado en Meta.
META_TEMPLATE_NAME=contacto_posventa
META_TEMPLATE_LANG=es
META_TEMPLATE_VENTA_NAME=contacto_venta
META_FIDELIZACION_TEMPLATE_NAME=fidelizacion_posventa

# ---- Red / acceso ----
# El sitio se publica SOLO en localhost para que lo alcance únicamente el nginx
# del servidor (que hace TLS y separa webhook-público / resto-interno).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Dominio real (para CORS): tiene que ser la URL por la que se entra.
FRONTEND_URL=https://calidad.apps.mariogoldsteinsa.com.ar

# ---- Operación ----
TZ=America/Argentina/Buenos_Aires
MODO_DEMO=false
MAX_ENVIOS_DIARIOS=200
HORA_INICIO_ENVIO=09:00
HORA_FIN_ENVIO=19:00

# ---- Backup offsite (opcional pero MUY recomendado en el server) ----
# S3-compatible (AWS/Backblaze B2/etc.). Si se deja vacío, el backup es local.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1

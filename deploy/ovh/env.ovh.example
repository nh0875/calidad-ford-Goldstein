# ============================================================================
#  .env.prod del SERVIDOR OVHcloud (las dos marcas)
# ============================================================================
#  Se copia a /opt/calidad/.env.prod (chmod 600). NUNCA al repositorio: tiene
#  todas las claves de las dos marcas.
#
#  De dónde sale cada valor:
#    [PC FORD]  copiarlo del .env.prod de la PC de Ford, con el MISMO nombre.
#    [PC VW]    copiarlo del .env.prod de la PC de Volkswagen, pero con el nombre
#               que figura acá (en la PC no tiene el VW_ adelante).
#    [NUEVO]    se genera ahora (openssl rand -hex 32) o sale de otro lado.
#
#  No hace falta copiarlos a mano: scripts\windows\Migrar-A-Servidor.bat arma en
#  cada PC un archivo con estos nombres ya puestos.
#
#  ⚠️ LO QUE NO PERDONA: CONFIG_ENCRYPTION_KEY y VW_CONFIG_ENCRYPTION_KEY. Cada
#     PC cifró su token de Meta con la suya. Si no son EXACTAMENTE las de cada PC,
#     la base migrada no puede leer su token y los WhatsApp no salen.
# ============================================================================

# Las dos marcas prendidas (calidad.sh además pasa --profile vw).
COMPOSE_PROFILES=vw
ENTORNO_PROD=si

# ---- Dominios y HTTPS ---------------------------------------------------------
# Tienen que apuntar a la IP del servidor ANTES de arrancar (registro A).
DOMINIO_FORD=
DOMINIO_VW=
# Let's Encrypt avisa acá si un certificado no se puede renovar.
ACME_EMAIL=
# Opcional. IPs públicas FIJAS de las concesionarias, separadas por espacio (ej:
# 200.45.10.20/32 181.30.5.8/32). Con esto la pantalla solo abre desde ahí; el
# webhook de Meta sigue abierto. Vacío = se entra desde cualquier lado.
#IPS_PERMITIDAS=

# ---- Base de datos (una sola, con una base por marca) -------------------------
POSTGRES_USER=calidad
# [NUEVO] openssl rand -hex 24 (la restauración no la necesita igual a la de la PC)
POSTGRES_PASSWORD=
POSTGRES_DB=calidad_ford
POSTGRES_DB_VW=calidad_vw

# ---- Operación común ------------------------------------------------------------
TZ=America/Argentina/Buenos_Aires
MODO_DEMO=false
ANALISIS_MODO_MOCK=false
JWT_EXPIRES_IN=8h
META_GRAPH_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_ENVIO_DELAY_MS=2500
DIAS_SIN_RESPUESTA_PARA_NC=5
MAX_ENVIOS_DIARIOS=200
HORA_INICIO_ENVIO=09:00
HORA_FIN_ENVIO=19:00
DELAY_AGRADECIMIENTO_MS=180000
DELAY_ANALISIS_MS=90000
RATE_LIMIT_POR_MINUTO=100
RATE_LIMIT_WEBHOOK_POR_MINUTO=600

# ============================================================================
#  FORD
# ============================================================================
# ⚠️ FORD. No copiar el MARCA de la PC de Volkswagen acá: convertiría a este
#    backend en Volkswagen.
MARCA=FORD

# [PC FORD]  ⚠️ exactamente la de la PC
CONFIG_ENCRYPTION_KEY=
# [PC FORD] (o [NUEVO]: solo obliga a volver a iniciar sesión)
JWT_SECRET=
# [PC FORD] (solo crea el admin si la base arranca vacía)
ADMIN_EMAIL=
# dejar VACÍO: al migrar, los usuarios ya existen
ADMIN_PASSWORD_INICIAL=

# [PC FORD]
META_WHATSAPP_TOKEN=
# [PC FORD]
META_PHONE_NUMBER_ID=
# [PC FORD]
META_WEBHOOK_VERIFY_TOKEN=
# [NUEVO] Meta for Developers -> la app de Ford -> Configuración -> Básica ->
# "Clave secreta de la app". Con esto el webhook rechaza lo que no firme Meta.
META_APP_SECRET=
META_TEMPLATE_NAME=contacto_posventa
META_TEMPLATE_LANG=es_AR
META_TEMPLATE_VENTA_NAME=contacto_venta
META_FIDELIZACION_TEMPLATE_NAME=fidelizacion_posventa
META_RESPUESTA_NO_RECIBIDA_NAME=respuesta_no_recibida
META_RESPUESTA_NO_RECIBIDA_LANG=es_AR

# [PC FORD]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# [PC FORD]
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# [PC FORD]
AI_PROVIDER=
ANALISIS_MAX_POR_MINUTO=8     # [PC FORD]

MAIL_HOST=smtp.gmail.com
MAIL_PUERTO=465
# [PC FORD] si tiene
MAIL_USUARIO=
# [PC FORD] si tiene (contraseña de APLICACIÓN de Google)
MAIL_PASSWORD=

# ============================================================================
#  VOLKSWAGEN
# ============================================================================
# [PC VW] su CONFIG_ENCRYPTION_KEY  ⚠️ exactamente la de la PC
VW_CONFIG_ENCRYPTION_KEY=
# [PC VW] su JWT_SECRET (tiene que ser DISTINTO del de Ford)
VW_JWT_SECRET=
# [PC VW] su ADMIN_EMAIL
VW_ADMIN_EMAIL=
# dejar VACÍO
VW_ADMIN_PASSWORD_INICIAL=

# [PC VW] su META_WHATSAPP_TOKEN
VW_META_WHATSAPP_TOKEN=
# [PC VW] su META_PHONE_NUMBER_ID
VW_META_PHONE_NUMBER_ID=
# [PC VW] su META_WEBHOOK_VERIFY_TOKEN
VW_META_WEBHOOK_VERIFY_TOKEN=
# [NUEVO] la clave secreta de la app de Volkswagen en Meta
VW_META_APP_SECRET=
VW_META_TEMPLATE_NAME=contacto_posventa
VW_META_TEMPLATE_LANG=es_AR
VW_META_TEMPLATE_VENTA_NAME=contacto_venta
VW_META_FIDELIZACION_TEMPLATE_NAME=fidelizacion_posventa
VW_META_RESPUESTA_NO_RECIBIDA_NAME=respuesta_no_recibida
VW_META_RESPUESTA_NO_RECIBIDA_LANG=es_AR

# Si se dejan vacías, VW usa las de Ford. Conviene que tenga las suyas: con una
# sola clave de IA, el cupo se reparte entre las dos marcas.
# [PC VW] su GEMINI_API_KEY
VW_GEMINI_API_KEY=
# [PC VW] su ANTHROPIC_API_KEY
VW_ANTHROPIC_API_KEY=
# [PC VW] su AI_PROVIDER
VW_AI_PROVIDER=
# [PC VW] su ANALISIS_MAX_POR_MINUTO
VW_ANALISIS_MAX_POR_MINUTO=
# [PC VW] su MAIL_USUARIO (calidadvolkswagengoldstein@gmail.com)
VW_MAIL_USUARIO=
# [PC VW] su MAIL_PASSWORD
VW_MAIL_PASSWORD=

# ============================================================================
#  RESPALDOS Y AVISOS
# ============================================================================
BACKUP_TZ=America/Argentina/Buenos_Aires
BACKUP_HOUR=03
VERIFY_DOW=7
VERIFY_HOUR=04
BACKUP_RETENTION_DAYS=14
VERIFY_MIN_CASOS=1

# Copia FUERA de OVH (recomendado: Backblaze B2, 10 GB gratis). Los backups de OVH
# viven en el mismo datacenter que el servidor: si se pierde la cuenta o el
# datacenter, se van juntos. En B2 la región TIENE que coincidir con el endpoint.
# ej. https://s3.us-east-005.backblazeb2.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# ej. us-east-005
BACKUP_S3_REGION=

# Monitor externo (healthchecks.io, gratis): una URL de "ping" por chequeo. Si el
# backup, la verificación o la actualización fallan O DEJAN DE CORRER, llega un
# mail. Vacío = sin aviso.
BACKUP_HEALTHCHECK_URL=
VERIFY_HEALTHCHECK_URL=
ACTUALIZACION_HEALTHCHECK_URL=

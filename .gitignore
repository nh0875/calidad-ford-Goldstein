# ===== Secretos y entorno (NUNCA a git) =====
# Cualquier variante: .env, .env.prod, .env.local, .env.backup, .env.viejo, etc.
.env*
# También cualquier archivo que TERMINE en .env (ej: no.env, local.env): suelen
# ser copias/renombres del .env con credenciales. NUNCA al repo.
*.env
# ...pero SÍ se versionan las plantillas de ejemplo (sin valores reales):
!.env.example
!.env.prod.example

# Token de ngrok para el instalador (secreto): va en el paquete, NO al repo.
scripts/windows/ngrok-token.txt
# Archivos generados por el instalador en cada PC (ruta de ngrok de esa maquina):
# se crean al instalar, no se versionan.
scripts/windows/ngrok-oculto.vbs
ngrok-path.txt

# ===== Datos de clientes (NUNCA a git) =====
# Todos los Excel con datos reales (Contacto Posventa, encuesta Ford, RQR, etc.)
*.xlsx
*.xls
*.csv

# ===== Backups / dumps de la base (contienen datos de clientes) =====
backups/
*.sql
*.sql.gz
*.dump

# Copia local de datos/credenciales traídos de la PC de Vanina (NUNCA al repo:
# tiene el dump con datos reales y el env.prod con las claves).
pcvanina/
# ...PERO las migraciones de Prisma SÍ se versionan (son esquema/código, no datos).
# Sin esta excepción, la regla *.sql las excluiría y la PC nueva no podría crear
# el esquema con `prisma migrate deploy`.
!backend/prisma/migrations/**/*.sql

# ===== Dependencias y builds =====
node_modules/
backend/node_modules/
frontend/node_modules/
dist/
backend/dist/
frontend/dist/
frontend/.vite/
# Caché incremental de TypeScript (se regenera al compilar)
*.tsbuildinfo

# ===== Archivos temporales de subida (Excel en proceso) =====
uploads-temp/
calidad-uploads/

# Compose de la PC local (build-based): lo usan las PCs de la oficina (Vanina /
# Yesica) y los scripts de Windows (vigilante, iniciar-sistema). NO va al repo:
# la regla de INDEN es sin `build:` en los compose; el del repo (docker-compose.yml)
# usa imagenes de GHCR. Se distribuye dentro del ZIP de instalacion, no por git.
docker-compose.prod.yml
docker-compose.local.yml

# ===== Logs y sistema =====
*.log
*.log.*
logs/
.DS_Store
Thumbs.db
npm-debug.log*

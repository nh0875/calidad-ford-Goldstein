# Marca de entorno: existe SOLO en este archivo. docker-compose.prod.yml la
# exige, para que levantar producción sin `--env-file .env.prod` falle de
# entrada en vez de arrancar en silencio con los valores de .env (desarrollo).
ENTORNO_PROD=si

# ===== PRODUCCIÓN — copiar a .env.prod y completar =====
# Este archivo NO debe subirse a ningún repositorio con valores reales.

# --- Base de datos (usar una contraseña fuerte y única) ---
POSTGRES_USER=calidad
POSTGRES_PASSWORD=CAMBIAR-POR-UNA-CONTRASENA-FUERTE
POSTGRES_DB=calidad_ford

# --- Puerto público del sistema ---
HTTP_PORT=80

# --- WhatsApp Business API (Meta) ---
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=CAMBIAR-POR-UN-TOKEN-ALEATORIO-LARGO
META_TEMPLATE_NAME=contacto_posventa
META_TEMPLATE_LANG=es_AR
# Plantilla del recordatorio de Fidelización (Parte C), pendiente de aprobación en Meta
META_FIDELIZACION_TEMPLATE_NAME=fidelizacion_posventa
# Base de la Graph API de Meta (no tocar en producción real)
META_GRAPH_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_ENVIO_DELAY_MS=2500
DIAS_SIN_RESPUESTA_PARA_NC=5
# Ventana horaria y tope diario de envíos de campaña (hora Argentina)
MAX_ENVIOS_DIARIOS=200
HORA_INICIO_ENVIO=09:00
HORA_FIN_ENVIO=19:00

# IMPORTANTE sobre las credenciales de Meta: el sistema las busca PRIMERO en la
# base (cargadas y cifradas desde la pantalla /configuracion) y, si ahí no hay,
# usa estas variables. En una instalación NUEVA la base arranca vacía, así que
# estas variables SÍ hay que completarlas (o cargar las credenciales desde
# /configuracion apenas se entra). Si se dejan vacías las dos vías, no se pueden
# enviar campañas ni recibir el webhook.

# --- IA (análisis de sentimiento / causa raíz) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Proveedor alternativo (opcional): si hay key de Gemini y NO de Anthropic, el
# análisis usa Gemini de verdad (vía REST, sin dependencia extra).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Fuerza el proveedor de IA: "gemini" | "anthropic". Vacío = automático.
AI_PROVIDER=
# false en producción para clasificar con la IA real
ANALISIS_MODO_MOCK=false
# Tope de análisis por minuto (rate limiter). FREE TIER de Gemini: 8. TIER PAGO
# (billing habilitado): se puede subir (ej. 30). Si volvés al free tier, poné 8.
ANALISIS_MAX_POR_MINUTO=8

# --- Modo demostración ---
# true = simula el envío de WhatsApp y habilita "Simular respuesta del cliente".
# Pensado para mostrar el sistema sin credenciales reales de Meta. En una
# instalación productiva real, dejar en false.
MODO_DEMO=false
# Demora del agradecimiento tras el último mensaje del cliente (3 min en producción)
DELAY_AGRADECIMIENTO_MS=180000

# Ventana de consolidación de la respuesta del cliente (ms). Cada mensaje nuevo
# reinicia la cuenta: el análisis corre cuando el cliente estuvo este tiempo sin
# escribir, y analiza TODA la tanda de una sola vez (una sola llamada a la IA,
# una sola clasificación). Bajarlo hace la demo más ágil; subirlo tolera mejor
# a los clientes que escriben lento.
DELAY_ANALISIS_MS=90000

# --- Cifrado de secretos en Configuración (credenciales de Meta) ---
# 32 bytes: openssl rand -hex 32. Necesaria para guardar el token de WhatsApp
# desde /configuracion. Si la rotás, hay que volver a cargar las credenciales.
CONFIG_ENCRYPTION_KEY=CAMBIAR-POR-32-BYTES-HEX

# --- Autenticación ---
# Generar con: openssl rand -hex 32 (un secreto propio de producción, distinto al de desarrollo)
JWT_SECRET=CAMBIAR-POR-UN-SECRETO-ALEATORIO-LARGO
JWT_EXPIRES_IN=8h
# Usuario ADMIN inicial (solo se crea si ese email no existe todavía; cambiar la
# contraseña desde el sistema apenas se entra por primera vez)
ADMIN_EMAIL=CAMBIAR-por-un-email-real@dominio.com
ADMIN_PASSWORD_INICIAL=CAMBIAR-POR-UNA-CONTRASENA-FUERTE

# --- Endurecimiento (CORS y rate limiting) ---
# Dominio(s) público(s) reales del sistema, separados por coma. Restringe CORS a
# ellos (nunca "*"). Detrás de nginx el frontend es mismo origen, así que si lo
# dejás vacío igual funciona; completalo si vas a llamar la API desde otro dominio.
FRONTEND_URL=https://calidad.tu-dominio.com
# Tope de requests por minuto por IP para toda la API (anti abuso / loops)
RATE_LIMIT_POR_MINUTO=100
# Tope aparte y holgado para /webhooks (Meta entrega en ráfagas; NO usa el global)
RATE_LIMIT_WEBHOOK_POR_MINUTO=600

# Zona horaria del backend (fechas "de hoy", ventana de envío y reportes por día).
# Sin esto el contenedor corre en UTC y los días se corren 3 horas.
TZ=America/Argentina/Buenos_Aires

# --- Backups y recuperación ante desastres ---
# Zona horaria y horarios del contenedor de backup
BACKUP_TZ=America/Argentina/Buenos_Aires
BACKUP_HOUR=03           # backup diario a las 03:00
VERIFY_DOW=7             # verificación semanal: 1=lunes ... 7=domingo
VERIFY_HOUR=04           # verificación a las 04:00 del día elegido
BACKUP_RETENTION_DAYS=14 # días de dumps locales antes de rotar
VERIFY_MIN_CASOS=1       # mínimo de filas de Caso que se espera al restaurar
# Almacenamiento OFFSITE S3-compatible. CRÍTICO: si el disco de la PC muere, sin
# esto se pierden la base Y los backups juntos. Ver el paso a paso de Backblaze
# B2 (10 GB gratis) en INSTALACION.md.
#
#   Backblaze B2:  endpoint y región los da el panel de B2 al crear el bucket.
#                  OJO: la región DEBE coincidir con el endpoint.
#                  Ej: endpoint https://s3.us-west-004.backblazeb2.com
#                      región   us-west-004
#   AWS S3:        dejar BACKUP_S3_ENDPOINT vacío y setear solo la región
#   DO Spaces:     https://nyc3.digitaloceanspaces.com  (región nyc3)
#
# Si se dejan vacíos, el backup se hace SOLO local (con aviso en el log).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
